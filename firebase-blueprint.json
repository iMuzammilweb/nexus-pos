{
  "entities": {
    "adminProfile": {
      "title": "Admin Profile",
      "description": "Master Super Admin system settings and display identity",
      "fields": {
        "fullName": { "type": "string", "description": "Display/CEO name" },
        "email": { "type": "string", "description": "Login email" },
        "password": { "type": "string", "description": "Admin password" },
        "companyName": { "type": "string", "description": "Organization name" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      }
    },
    "stores": {
      "title": "Store Branch",
      "description": "Individual restaurant branch records with isolated POS access",
      "fields": {
        "id": { "type": "string", "description": "Store ID" },
        "businessName": { "type": "string", "description": "Store branch name" },
        "storeCode": { "type": "string", "description": "Store branch code" },
        "email": { "type": "string", "description": "Store branch email" },
        "storeUsername": { "type": "string", "description": "Login username" },
        "storePassword": { "type": "string", "description": "Login password" },
        "address": { "type": "string", "description": "Street address" },
        "city": { "type": "string", "description": "City" },
        "postcode": { "type": "string", "description": "Postcode" },
        "activeStatus": { "type": "string", "description": "Active or Suspended" }
      }
    },
    "orders": {
      "title": "Order",
      "description": "Customer orders partitioned by storeId with real-time timers",
      "fields": {
        "storeId": { "type": "string", "description": "Partition key store ID" },
        "invoiceId": { "type": "string", "description": "Unique invoice ID" },
