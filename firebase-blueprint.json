        "grandTotal": { "type": "number", "description": "Total amount in GBP" },
        "createdAt": { "type": "string", "description": "ISO timestamp" }
      }
    },
    "customers": {
      "title": "Customer Record",
      "description": "Secure customer directory indexed by normalized phone and storeId",
      "fields": {
        "storeId": { "type": "string", "description": "Authorized store ID" },
        "name": { "type": "string", "description": "Customer full name" },
