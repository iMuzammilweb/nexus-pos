      }
    },
    "staffAccounts": {
      "title": "Staff Account",
      "description": "Phone operator staff accounts with multi-store access permissions",
      "fields": {
        "id": { "type": "string", "description": "Staff ID" },
        "name": { "type": "string", "description": "Staff operator name" },
        "username": { "type": "string", "description": "Login username" },
        "email": { "type": "string", "description": "Staff email" },
        "phone": { "type": "string", "description": "Contact phone" },
        "role": { "type": "string", "description": "STAFF" },
        "assignedStoreId": { "type": "string", "description": "Primary or active store" },
        "assignedStoreIds": { "type": "array", "description": "List of authorized store IDs" },
        "status": { "type": "string", "description": "Active or Disabled" }
      }
    }
