        "normalizedPhone": { "type": "string", "description": "Sanitized phone for deduplication" },
        "address": { "type": "string", "description": "Primary delivery street address" },
        "postcode": { "type": "string", "description": "Delivery postcode" },
        "totalOrders": { "type": "number", "description": "Cumulative completed orders" },
        "totalSpend": { "type": "number", "description": "Cumulative spending amount" }
      }
    },
    "addons": {
      "title": "Add-On Modifier",
      "description": "Menu add-ons linked to products",
      "fields": {
        "storeId": { "type": "string", "description": "Store ID or all" },
        "name": { "type": "string", "description": "Add-on name" },
        "price": { "type": "number", "description": "Price modifier in GBP" },
        "isAvailable": { "type": "boolean", "description": "Availability toggle" },
        "category": { "type": "string", "description": "Add-on category group" },
        "linkedProductIds": { "type": "array", "description": "Linked product IDs" }
      }
    },
    "products": {
      "title": "Menu Product",
      "description": "Restaurant menu items with variants and add-on links",
      "fields": {
        "storeId": { "type": "string", "description": "Store ID" },
        "categoryId": { "type": "string", "description": "Category ID" },
